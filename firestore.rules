rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function active() { return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    function admin() { return active() && request.auth.token.get('email_verified', false) && request.auth.token.get('email', '') in ['asulchoi@gmail.com','xilencist@gmail.com']; }
    function aggregateValid(id) {
      let before = get(/databases/$(database)/documents/articles/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/articles/$(id)).data;
      let path = /databases/$(database)/documents/articles/$(id)/reviews/$(request.auth.uid);
      let previous = exists(path) ? get(path).data.rating : 0;
      let review = getAfter(path).data;
      let count = before.get('ratingCount', 0) + (exists(path) ? 0 : 1);
      let sum = before.get('ratingSum', before.get('averageRating', 0) * before.get('ratingCount', 0)) - previous + review.rating;
      return active() && review.userId == request.auth.uid && review.updatedAt == request.time
        && after.lastReviewUid == request.auth.uid && after.reviewUpdatedAt == request.time
        && after.ratingCount == count && after.ratingSum == sum
        && after.averageRating >= sum * 1.0 / count - 0.000001 && after.averageRating <= sum * 1.0 / count + 0.000001;
    }
    function validReview() {
      let d = request.resource.data;
      return d.keys().hasOnly(['rating','pros','cons','userId','userDisplayName','createdAt','updatedAt'])
        && d.userId == request.auth.uid && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.pros is string && d.pros.size() <= 2000 && d.cons is string && d.cons.size() <= 2000
        && d.userDisplayName is string && d.userDisplayName.size() <= 100 && d.updatedAt == request.time;
    }
    match /articles/{id} {
      allow read: if true;
      allow create: if active() && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.content is string && request.resource.data.content.size() >= 80 && request.resource.data.content.size() <= 10000
        && request.resource.data.level in ['A1','A2','B1','B2','C1','C2']
        && request.resource.data.averageRating == 0 && request.resource.data.ratingCount == 0;
      allow update: if admin() || (active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum','ratingCount','averageRating','lastReviewUid','reviewUpdatedAt']) && aggregateValid(id));
      allow delete: if admin();
      match /reviews/{uid} {
        allow read: if true;
        allow create: if owner(uid) && validReview() && request.resource.data.createdAt == request.time && aggregateValid(id);
        allow update: if owner(uid) && validReview() && request.resource.data.createdAt == resource.data.createdAt && aggregateValid(id);
        // During account deletion retain only an anonymous rating contribution.
        allow update: if request.auth != null && resource.data.get('userId','') == request.auth.uid
          && exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId','userDisplayName','pros','cons'])
          && !('userId' in request.resource.data) && request.resource.data.userDisplayName == 'Deleted account'
          && request.resource.data.pros == '' && request.resource.data.cons == '';
        allow delete: if false;
      }
    }
    match /{path=**}/reviews/{id} { allow read: if true; }
    match /accountDeletions/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['startedAt']) && request.resource.data.startedAt == request.time;
    }
    match /users/{uid} {
      allow read, delete: if owner(uid) || admin();
      allow create, update: if (owner(uid) && active()) || admin();
      match /{collection}/{id} {
        allow read, delete: if owner(uid) && collection in ['vocabulary','readArticles','customCategories'];
        allow create, update: if owner(uid) && active() && collection in ['vocabulary','readArticles','customCategories'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
