{
  "name": "korean-reading-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test:browser": "playwright test",
    "test:integration": "node --require ./tests/server-only.cjs --import tsx --test tests/security.integration.ts",
    "test:emulators": "npx firebase-tools emulators:exec --only firestore --project demo-koreading \"npm run test:integration\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "firebase": "^12.19.0",
    "next": "^16.2.6",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
