NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
GEMINI_API_KEY=your_gemini_api_key
# Optional Groq provider for fallback / dictionary priority.
GROQ_API_KEY=your_groq_api_key

# Optional image search. Wikipedia and curated images work without it.
UNSPLASH_ACCESS_KEY=
# Cron routes require an exact Authorization: Bearer <CRON_SECRET> header.
CRON_SECRET=
# REQUIRED together for deployed/production AI requests: missing or unavailable Redis fails closed (HTTP 503).
# Both values may be omitted ONLY in local development; local fallback is per-process, not globally shared.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional global daily HTTP request cap (default 1000), not a provider-call or billing cap.
AI_DAILY_REQUEST_LIMIT=1000
# Optional quota-identity hashing salt (validated Vercel client IP or shared unverified group).
AI_RATE_LIMIT_SALT=
# Comma-separated admin emails for admin-only features (client guard).
# Must stay in sync with the admin() rule in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAILS=asulchoi@gmail.com,xilencist@gmail.com
